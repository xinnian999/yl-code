{
  "name": "niu-code",
  "version": "1.0.5",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "niu": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/cli/index.ts",
    "start": "bun src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "verify": "bun run build && node dist/index.js",
    "verify:pack": "bun run build && npm pack"
  },
  "keywords": ["cli", "ai", "terminal", "ink"],
  "author": "",
  "license": "ISC",
  "description": "终端内 AI 助手 CLI，输入 niu 即可召唤使用",
  "dependencies": {
    "@langchain/core": "^1.1.8",
    "@langchain/openai": "^1.2.0",
    "chalk": "^5.6.2",
    "diff": "^8.0.3",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "ink-form": "^2.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/ink-spinner": "^3.0.5",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.13",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
