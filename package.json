{
  "name": "yl-code",
  "version": "1.0.13",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yl": "./dist/index.js"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm run build && node dist/index.js",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run build && node dist/index.js",
    "verify:pack": "pnpm run build && pnpm pack",
    "release": "pnpm run build && pnpm version patch && pnpm publish",
    "worker:dev": "pnpm --filter @yl-code/model-proxy dev",
    "worker:test": "pnpm --filter @yl-code/model-proxy test",
    "worker:typecheck": "pnpm --filter @yl-code/model-proxy typecheck",
    "worker:deploy": "pnpm --filter @yl-code/model-proxy deploy"
  },
  "keywords": [
    "cli",
    "ai",
    "terminal",
    "ink"
  ],
  "author": "",
  "license": "ISC",
  "description": "终端内 AI 助手 CLI，输入 yl 即可召唤使用",
  "dependencies": {
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.2.0",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.4.0",
    "diff": "^8.0.3",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "ink-big-text": "^2.0.0",
    "ink-form": "^2.0.1",
    "ink-gradient": "^4.0.0",
    "ink-markdown-es": "^1.1.0",
    "ink-scroll-list": "^0.4.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-task-list": "^2.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/ink-spinner": "^3.0.5",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
